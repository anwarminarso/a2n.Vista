<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AOT verification probe for the source generator. Two paths are exercised as a BUILD-TIME analyzer
    check (not a runtime sample), with any trim/AOT warning promoted to a build error:

      * Phase 1 export path (Spec source-generator, Task 5.2, R6.3): ExportColumns.Value(view, row, field)
        and CsvViewExportWriter.WriteAsync — the generated-accessor covered export path.

      * Phase 2 Style B executable path (Spec style-b-executable, Task 11.1, R5.1/R5.4/R5.5/R1.7):
        the generated ICompiledViewExecutionPlan driven through EfViewExecutor.ListCompiledAsync /
        DetailCompiledAsync — the *non-RUC* compiled List and Detail read path. Routing through these
        helpers (rather than the public RUC ListAsync/DetailAsync) keeps the analyzed surface exactly the
        generated Style B path, so a green build proves it is free of IL2026 (RequiresUnreferencedCode)
        and IL3050 (RequiresDynamicCode).

      * Phase 3 write-mapper path (Spec source-generator-write-mapper, Task 11.1, R10.1-R10.6): the
        generated WriteMapper resolved through WriteMapperResolver and applied to an entity.

      * Phase 4 HTTP-surface round-trip (Spec source-generator-http-surface, Task 11.1, R8.1/R8.2/R8.3;
        D123/D124): the generated IViewInvoker (resolved from a2n.Vista.Core's ViewInvokerStore) dispatches
        List + Detail (read-only view) and Create + Update (writable view) over the *non-RUC* executor
        facets, a write body is bound through the seam (VistaWriteBinding.BindModel), and every response is
        serialized through the Serialization_Seam (VistaJson.Options + TypeInfoResolverChain) using the
        shipped VistaStaticJsonContext plus a probe App_Json_Context, with the reflection fallback resolver
        removed (DisableReflectionFallback). A green build proves this full typed Style B round-trip is free
        of IL2026/IL3050. A Style A (central-template, anonymous) view is present to demonstrate the
        coexistence boundary: it has no generated invoker and keeps its permanent RUC path (D96 / R8.3),
        isolated behind a narrowly-scoped suppression — it is not required to be AOT-clean.

    A green build IS the verification. No native toolchain is required: <IsAotCompatible>true</IsAotCompatible>
    enables BOTH the trim analyzer and the AOT analyzer, which surface IL2026/IL3050 during `dotnet build`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Override the repo-wide multi-targeting: net8.0 only (lowest TFM, matches the Northwind constraint). -->
    <TargetFramework>net8.0</TargetFramework>
    <TargetFrameworks />
    <RootNamespace>a2n.Vista.AotProbe</RootNamespace>
    <AssemblyName>a2n.Vista.AotProbe</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Enables EnableTrimAnalyzer + EnableAotAnalyzer (and EnableSingleFileAnalyzer) at build time. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      Any trim/AOT warning on the covered path must FAIL the build. Scope warnings-as-errors to the
      trim/AOT diagnostic codes (rather than TreatWarningsAsErrors=true) so unrelated style/nullable
      warnings do not mask the signal we actually care about.
        IL2026 = call to a [RequiresUnreferencedCode] member
        IL3050 = call to a [RequiresDynamicCode] member
        IL2091/IL2087/IL2072/IL2075/IL2070 = generic/dataflow trim warnings
        IL3000/IL3001/IL3002/IL3003 = single-file / AOT warnings
    -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050;IL2091;IL2087;IL2072;IL2075;IL2070;IL3000;IL3001;IL3002;IL3003</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The covered export path lives in Core: ExportColumns + ViewAccessorRegistry + CsvViewExportWriter. -->
    <ProjectReference Include="..\..\a2n.Vista.Core\a2n.Vista.Core.csproj" />

    <!--
      Phase 4 (spec source-generator-http-surface, Task 11.1, R8.1/R8.2/R8.3; Decision Log D123/D124):
      the AOT-clean serialization seam lives in the ASP.NET Core layer (VistaJson.Options +
      TypeInfoResolverChain, the shipped VistaStaticJsonContext, VistaJsonWriter, and the
      VistaWriteBinding.BindModel write-body binder). Referencing it lets the probe bind a write body and
      serialize List/Detail/write responses through the seam using the Static_Envelope_Context plus a
      probe-authored App_Json_Context, with the reflection fallback resolver removed — so a green build
      proves the full typed Style B dispatch + serialization round-trip is free of IL2026/IL3050. The
      generated dispatch invoker itself is Core-only; only the serialization seam pulls in AspNetCore. -->
    <ProjectReference Include="..\..\a2n.Vista.AspNetCore\a2n.Vista.AspNetCore.csproj" />

    <!--
      Phase 2 (spec style-b-executable, Task 11.1, R5.1/R5.4/R5.5/R1.7): the generated Style B
      List/Detail path lives in the EF layer (EfViewExecutor compiled helpers + ICompiledViewExecutionPlan
      + GeneratedExecutionPlanStore). Referencing the EF layer also makes the EF-aware Phase 2 emitter
      run over this assembly's partial Style B view (CompiledPlanSupported == true).
    -->
    <ProjectReference Include="..\..\a2n.Vista.EntityFrameworkCore\a2n.Vista.EntityFrameworkCore.csproj" />

    <!--
      Reference the generator as an ANALYZER only (no runtime assembly dependency), exactly how a real
      consumer wires it (Spec 03 D71). With the EF-layer types present above, the generator emits — INTO
      this probe assembly — a `file sealed` CompiledViewExecutionPlan_<View> plus a [ModuleInitializer]
      that registers the plan into GeneratedExecutionPlanStore at module load. The probe then runs that
      REAL generated plan through the compiled (non-RUC) List/Detail path under the trim/AOT analyzer.
    -->
    <ProjectReference Include="..\..\a2n.Vista.SourceGenerators\a2n.Vista.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite provider for the self-contained probe DbContext (net8.0 → EF Core 8.0.x, centrally pinned). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

</Project>
