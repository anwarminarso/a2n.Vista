<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Real generator consumer for the Style B *executable* compiled read path's masking runtime
    (Spec style-b-executable, Property 5 / task 9.2). Like a2n.Vista.GeneratorExecSampleP4, it
    references BOTH Core and the EF layer, so the generator's Phase 2 emitter produces a real
    AOT-clean ICompiledViewExecutionPlan for the declared partial typed Style B view and registers
    it into GeneratedExecutionPlanStore via a [ModuleInitializer] at module load.

    It declares exactly one view (P5AccountView) whose row type is a RECORD with a masked field, so
    the generator emits a `with`-style rebuild for the mask accessor's setter — the success path that
    the conditional-masking-at-materialization property needs (an init-only property on a non-record
    class would instead emit a fail-closed setter). The masker depends on the original value (R7.3),
    and the shouldMask predicate reads a DI toggle so the test can flip masking on/off per request.
    The project is scoped to that one test (P5 prefix) so it cannot collide with sibling fixtures.

    Multi-targeting (net8.0;net9.0;net10.0) is inherited from Directory.Build.props — do NOT override —
    so the generated plan is proven to compile on every TFM.
  -->
  <PropertyGroup>
    <RootNamespace>a2n.Vista.GeneratorExecSampleP5</RootNamespace>
    <AssemblyName>a2n.Vista.GeneratorExecSampleP5</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- View<TQuery> + masking primitives live in Core; ICompiledViewExecutionPlan + the store live in EF. -->
    <ProjectReference Include="..\..\a2n.Vista.Core\a2n.Vista.Core.csproj" />
    <ProjectReference Include="..\..\a2n.Vista.EntityFrameworkCore\a2n.Vista.EntityFrameworkCore.csproj" />

    <!--
      Reference the generator as an ANALYZER only (no runtime assembly dependency) — exactly how a real
      consumer wires it. Because Core AND EF are referenced above, the generator's CompiledPlanSupported
      gate is satisfied and the Phase 2 execution plan is emitted for the analyzable single-source view.
    -->
    <ProjectReference Include="..\..\a2n.Vista.SourceGenerators\a2n.Vista.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
