<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test project for a2n.Vista (Decision Log D7: TUnit on Microsoft.Testing.Platform).
    TUnit is not VSTest-based; it compiles the test project to an executable and runs
    via Microsoft.Testing.Platform. `dotnet test` (with the .NET 10 SDK) and `dotnet run`
    both work; `dotnet test` is preferred because it exercises every targeted TFM.
    The `dotnet test` MTP runner is opted into via global.json (test.runner).

    TargetFrameworks (net8.0;net9.0;net10.0), Nullable, ImplicitUsings, and LangVersion
    are inherited from Directory.Build.props to stay aligned with the rest of the solution.
  -->
  <PropertyGroup>
    <RootNamespace>a2n.Vista.Tests</RootNamespace>
    <AssemblyName>a2n.Vista.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Metapackage: pulls TUnit.Core, TUnit.Engine, and TUnit.Assertions. -->
    <PackageReference Include="TUnit" />
    <!-- Property-based testing (CsCheck): generated/RUC behavioral parity (Property 1, task 7.6). -->
    <PackageReference Include="CsCheck" />
    <!--
      SQLite EF Core provider for the paging tests (task 12.5): exercises the real EfViewExecutor
      List path against a relational provider that translates LIKE / supports async cancellation.
      Version is pinned per-TFM in Directory.Packages.props (central package management).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core shared framework, needed for the AspNetCore reference at runtime (tasks 12.6+). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- In-process TestServer for the HTTP endpoint integration tests. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\a2n.Vista.Core\a2n.Vista.Core.csproj" />
    <ProjectReference Include="..\..\a2n.Vista.EntityFrameworkCore\a2n.Vista.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\a2n.Vista.AspNetCore\a2n.Vista.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Adapters\a2n.Vista.Adapters.DataTablesNet\a2n.Vista.Adapters.DataTablesNet.csproj" />
    <!--
      End-to-end generator consumer (Spec source-generator, Task 6.1, R6.4): referencing this sample
      loads its [ModuleInitializer]-driven accessor registration so GeneratorEndToEndTests can assert
      the GENERATED accessors are present in ViewAccessorRegistry at runtime.
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.GeneratorSample\a2n.Vista.GeneratorSample.csproj" />
    <!--
      EF + source-generator consumer hosting the REAL generated compiled execution plan exercised by the
      Generated/RUC behavioral-parity property test (GeneratedRucParityPropertyTests, task 7.6). The test
      project cannot reference the generator directly (its non-partial Style B views would trip VISTA0001),
      so the generated plan is produced in this dedicated sample and consumed here.
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.StyleBExecSample\a2n.Vista.StyleBExecSample.csproj" />
    <!--
      EF-aware generator consumer for the compiled execution plan (spec style-b-executable, Property 3):
      its partial Style B views get a REAL generated CompiledViewExecutionPlan registered into
      GeneratedExecutionPlanStore at module load, which DetailByKeyRoundTripPropertyTests drives.
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.Examples.StyleBExecP3\a2n.Vista.Examples.StyleBExecP3.csproj" />
    <!--
      EF + source-generator consumer hosting the REAL generated compiled execution plan with a
      masked-without-opt-in field, exercised by the disallowed filter/sort rejection property test
      (DisallowedFieldRejectionPropertyTests, task 7.5 / Property 4).
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.GeneratorExecSampleP4\a2n.Vista.GeneratorExecSampleP4.csproj" />
    <!--
      EF + source-generator consumer hosting the REAL generated compiled execution plan with a
      conditionally-masked (record-row) field, exercised by the conditional-masking-at-materialization
      property test (ConditionalMaskingPropertyTests, task 9.2 / Property 5).
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.GeneratorExecSampleP5\a2n.Vista.GeneratorExecSampleP5.csproj" />
    <!--
      EF + source-generator consumer hosting the REAL generated compiled execution plan with a
      masked-without-opt-in field, exercised by the non-probeable masked-field property test
      (NonProbeableMaskedFieldPropertyTests, task 9.3 / Property 6).
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.GeneratorExecSampleP6\a2n.Vista.GeneratorExecSampleP6.csproj" />
    <!--
      EF + source-generator consumer hosting REAL generated compiled execution plans for KEYLESS and
      EXPLICIT-key single-source views, exercised by the single-source PK auto-derivation property test
      (SingleSourcePkDerivationPropertyTests, task 10.2 / Property 7).
    -->
    <ProjectReference Include="..\..\Examples\a2n.Vista.Examples.StyleBExecP7\a2n.Vista.Examples.StyleBExecP7.csproj" />
  </ItemGroup>

</Project>
