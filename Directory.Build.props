<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>Anwar Minarso</Authors>
    <Copyright>Anwar Minarso @ 2026</Copyright>
    <RepositoryUrl>https://github.com/anwarminarso/a2n.Vista</RepositoryUrl>
    <PackageProjectUrl>https://github.com/anwarminarso/a2n.Vista</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Version>0.0.1</Version>
    <!--
      License metadata. The project is LGPL-3.0-or-later (see LICENSE, COPYING, NOTICES.md, and
      the README). Until this was set, `dotnet pack` emitted packages with NO <license> element at
      all and did so SILENTLY — no warning — so nuget.org would have shown no license and a
      consumer's compliance scanner would have found nothing to read. That matters more than usual
      for a copyleft license: a consumer cannot honour terms that the package never declares.
      An SPDX expression is used rather than PackageLicenseFile so the license is machine-readable.
    -->
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <!--
      Symbols + SourceLink so consumers can step into the library. The .NET 8+ SDK includes
      SourceLink for GitHub repositories, so no extra package reference is needed; these three
      properties are what turn it on and ship a .snupkg alongside each .nupkg (`dotnet nuget push`
      uploads the matching symbol package automatically).
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      Deterministic, normalized paths in CI builds only: GitHub Actions sets CI=true, so a local
      build keeps its absolute paths (which is what a local debugger wants) while a published
      package is reproducible.
    -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Brand icon shown on nuget.org. The a2n wordmark, downscaled to 1024x480
         (~328 KB) to stay under NuGet's 1 MB package-icon limit. -->
    <PackageIcon>icon.png</PackageIcon>
    <!-- Per-package README rendered on the nuget.org package page, opt-in by the presence
         of a README.md next to the csproj. Images in this file must use absolute URLs
         (nuget.org does not render repository-relative image paths). -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack the brand icon at the package root for every shipping package. Inert for
         projects that never pack (tests, examples). Path is relative to this props file
         (repo root) so it resolves the same for all projects. Lives in the tracked
         assets/ folder (brand/ is git-ignored design scratch and must not be shipped). -->
    <None Include="$(MSBuildThisFileDirectory)assets\a2n-vista-wordmark.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <!-- Pack the per-package README at the package root, when the project provides one. -->
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" Visible="false"
          Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive advisory acknowledged and suppressed for the audit (was declared in the former
         stray src/Directory.Packages.props, moved here so it applies solution-wide). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <!-- Microsoft.OpenApi 2.0.0 arrives transitively via the official Microsoft.AspNetCore.OpenApi 10.0.0
         (net10 built-in OpenAPI pipeline; spec openapi-emitter task 7.2). It is the version the shipped
         ASP.NET Core package pins, so the advisory is acknowledged and suppressed until the framework
         package advances its transitive pin. Only affects net10 of a2n.Vista.OpenApi and its consumers. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>
</Project>
